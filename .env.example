# Leave DATABASE_URL empty to use the local PGlite database in .data/pglite
DATABASE_URL=
# PGLITE_DIR=.data/pglite

# Sign-in: dev (local stand-in user) | password (shared-password gate; production default)
AUTH_PROVIDER=dev
DEV_USER_EMAIL=jframe@framearchitecture.com
DEV_USER_NAME=Jeff Frame
# ALLOW_DEV_AUTH=1   # only to run a production build locally
# For AUTH_PROVIDER=password:
# SITE_PASSWORD=
# SESSION_SECRET=   # 32+ random characters

# Optional: "Polish with Claude" on proposals
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# Optional: PDF colours to match the chosen theme
# PDF_ACCENT=#2E5E73
# PDF_INK=#1D1F22
