    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
