{
  "name": "frame-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Frame Architecture all-in-one: proposals, sales CRM, projects",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
